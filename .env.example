# Local-only configuration. Never commit a populated .env file.
ASPNETCORE_ENVIRONMENT=Development
ARCHIVIST_API_PORT=5080
# SQL Server requires at least eight characters from three character classes.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
ConnectionStrings__Archivist=Server=localhost,1433;Database=archivist;User Id=sa;Password=replace-with-a-strong-local-password;Encrypt=False;TrustServerCertificate=True
Entra__TenantId=
Entra__ClientId=
AzureAiFoundry__Endpoint=
AzureAiFoundry__ChatDeployment=
AzureAiFoundry__EmbeddingDeployment=
